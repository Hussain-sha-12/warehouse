<h2>Stock Transaction History</h2>

<p>
    <a href="/warehouse/public/dashboard">
        Back to Dashboard
    </a>
</p>

<table border="1" cellpadding="8" cellspacing="0">

    <tr>
        <th>ID</th>
        <th>Product</th>
        <th>Warehouse</th>
        <th>Transaction Type</th>
        <th>Quantity</th>
        <th>Reference</th>
        <th>Transaction Date</th>
        <th>Created By</th>
    </tr>

