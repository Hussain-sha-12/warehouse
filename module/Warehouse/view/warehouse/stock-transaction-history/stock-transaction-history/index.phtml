                <?= htmlspecialchars(
                    $transaction['ProductName']
                ); ?>
            </td>

            <td>
                <?= htmlspecialchars(
                    $transaction['WarehouseCode']
                ); ?>
                -
                <?= htmlspecialchars(
                    $transaction['WarehouseName']
                ); ?>
            </td>

