<h2>Customers</h2>

<p>
    <a href="<?= $this->url('customer-create') ?>">
        + Add Customer
    </a>
</p>

<table border="1" cellpadding="10" cellspacing="0">

    <tr>
        <th>ID</th>
        <th>Code</th>
        <th>Name</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Address</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    <?php foreach ($customers as $customer): ?>

        <tr>

            <td><?= (int) $customer['CustomerID'] ?></td>

            <td><?= $this->escapeHtml(
                $customer['CustomerCode']
            ) ?></td>

            <td><?= $this->escapeHtml(
                $customer['CustomerName']
            ) ?></td>

            <td><?= $this->escapeHtml(
                $customer['Phone']
            ) ?></td>

            <td><?= $this->escapeHtml(
                $customer['Email']
            ) ?></td>

            <td><?= $this->escapeHtml(
                $customer['Address']
            ) ?></td>

            <td>
                <?= $customer['IsActive'] ? 'Active' : 'Inactive' ?>
            </td>

            <td>
                <a href="<?= $this->url(
                    'customer-edit',
                    ['id' => $customer['CustomerID']]
                ) ?>">
                    Edit
                </a>

                |

                <a href="<?= $this->url(
                    'customer-delete',
                    ['id' => $customer['CustomerID']]
                ) ?>"
                   onclick="return confirm('Deactivate this customer?');">
                    Delete
                </a>
            </td>

        </tr>

    <?php endforeach; ?>

</table>