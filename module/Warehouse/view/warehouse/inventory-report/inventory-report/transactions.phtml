                ) ?>
            </option>

        <?php endforeach; ?>

    </select>

    &nbsp;

    <label>Transaction Type:</label>

    <select name="TransactionType">

        <option value="">
            All
        </option>

        <option
            value="IN"
            <?= $transactionType === 'IN'
                ? 'selected'
                : '' ?>
        >
            Stock IN
        </option>

        <option
            value="OUT"
            <?= $transactionType === 'OUT'
                ? 'selected'
                : '' ?>
        >
            Stock OUT
        </option>

    </select>

    <br><br>

    <label>From Date:</label>

    <input
        type="date"
        name="FromDate"
        value="<?= $this->escapeHtml($fromDate) ?>"
    >

    &nbsp;

    <label>To Date:</label>

    <input
        type="date"
        name="ToDate"
        value="<?= $this->escapeHtml($toDate) ?>"
    >

