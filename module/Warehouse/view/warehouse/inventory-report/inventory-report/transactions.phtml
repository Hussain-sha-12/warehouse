<?php else: ?>

    <p>
        <strong>
            No transactions found for the selected filters.
        </strong>
    </p>

<?php endif; ?>


<?php
/*
 * Compact Pagination
 */

if ($totalPages > 1):

    $buildPageUrl = function ($targetPage) {

        return $this->url(
            'inventory-report-transactions',
            [],
            [
                'query' => [
                    'page'            => $targetPage,
                    'perPage'         => $perPage,
                    'WarehouseID'     => $warehouseId,
                    'TransactionType' => $transactionType,
                    'FromDate'        => $fromDate,
                    'ToDate'          => $toDate
                ]
            ]
        );
    };

    $startPage =
        max(
            1,
            $page - 2
        );

    $endPage =
        min(
            $totalPages,
            $page + 2
        );
?>

<hr>

<div style="margin-top:15px;">

    <?php if ($page > 1): ?>

        <a href="<?= $buildPageUrl(1) ?>">
            First
        </a>

        &nbsp;

        <a href="<?= $buildPageUrl($page - 1) ?>">
            Prev
        </a>

        &nbsp;

    <?php endif; ?>


    <?php if ($startPage > 1): ?>

        <a href="<?= $buildPageUrl(1) ?>">
            1
        </a>

        &nbsp;

        <?php if ($startPage > 2): ?>

            ...
            &nbsp;

        <?php endif; ?>

    <?php endif; ?>


    <?php for (
        $paginationPage = $startPage;
        $paginationPage <= $endPage;
        $paginationPage++
    ): ?>

        <?php if ($paginationPage == $page): ?>

            <strong>
                [<?= $paginationPage ?>]
            </strong>

        <?php else: ?>

            <a href="<?= $buildPageUrl(
                $paginationPage
            ) ?>">
                <?= $paginationPage ?>
            </a>

        <?php endif; ?>

        &nbsp;

    <?php endfor; ?>


    <?php if ($endPage < $totalPages): ?>

        <?php if ($endPage < $totalPages - 1): ?>

            ...
            &nbsp;

        <?php endif; ?>

        <a href="<?= $buildPageUrl($totalPages) ?>">
            <?= $totalPages ?>
        </a>

        &nbsp;

    <?php endif; ?>


    <?php if ($page < $totalPages): ?>

        <a href="<?= $buildPageUrl($page + 1) ?>">
            Next
        </a>

        &nbsp;

        <a href="<?= $buildPageUrl($totalPages) ?>">
            Last
        </a>

    <?php endif; ?>

</div>

<p>
    Page <?= (int) $page ?>
    of <?= (int) $totalPages ?>
</p>

<?php endif; ?>