    ) ?>">
        Clear
    </a>

</form>

<hr>

<?php if (!empty($error)): ?>

    <p>
        <strong>
            <?= $this->escapeHtml($error) ?>
        </strong>
    </p>

<?php endif; ?>

<h3>
    Transactions

    <?php if ($totalRecords > 0): ?>

        <small>
            (<?= (int) $totalRecords ?> records)
        </small>

    <?php endif; ?>

</h3>

<?php if ($totalRecords > 0): ?>

<table
    border="1"
    cellpadding="8"
    cellspacing="0"
>

    <tr>

        <th>ID</th>
        <th>Product Code</th>
        <th>Product Name</th>
        <th>Warehouse</th>
        <th>Type</th>
        <th>Quantity</th>
        <th>Reference</th>
        <th>Reference ID</th>
        <th>Date</th>
        <th>Created By</th>

    </tr>

    <?php foreach ($transactions as $transaction): ?>

        <tr>

            <td>
                <?= (int) $transaction['TransactionID'] ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $transaction['ProductCode']
                ) ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $transaction['ProductName']
                ) ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $transaction['WarehouseName']
                ) ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $transaction['TransactionType']
                ) ?>
            </td>

            <td>
                <?= (int) $transaction['Quantity'] ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $transaction['ReferenceType']
                ) ?>
            </td>

            <td>
                <?= (int) $transaction['ReferenceID'] ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $transaction['TransactionDate']
                ) ?>
            </td>

            <td>
                <?= (int) $transaction['CreatedBy'] ?>
            </td>

