<h2>Stock Transaction History</h2>

<p>
    <a href="<?= $this->url('inventory-report') ?>">
        Inventory Report
    </a>
</p>

<hr>

<h3>Filter Transactions</h3>

<form method="post">

    <label>Warehouse:</label>

    <select name="WarehouseID">

        <option value="">
            All Warehouses
        </option>

        <?php foreach ($warehouses as $warehouse): ?>

            <option
                value="<?= (int) $warehouse['WarehouseID'] ?>"
                <?= (
                    (string) $warehouseId ===
                    (string) $warehouse['WarehouseID']
                ) ? 'selected' : '' ?>
            >
                <?= $this->escapeHtml(
