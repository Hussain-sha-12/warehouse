<!-- =========================
     INVENTORY KPI CARDS
     ========================= -->

<div class="stats-grid">

    <div class="stat-card">
        <h3>Inventory Items</h3>

        <div class="number kpi-counter"
             data-target="<?= (int) $data['inventoryItems'] ?>">
            0
        </div>

        <div class="kpi-progress-ring success"
             data-progress="<?= $data['products'] > 0 ? min(100, (($data['inventoryItems'] / $data['products']) * 100)) : 0 ?>">
            <span>0%</span>
        </div>
    </div>


    <div class="stat-card">
        <h3>Total Stock Quantity</h3>

        <div class="number kpi-counter"
             data-target="<?= (int) $data['totalStock'] ?>">
            0
        </div>

        <div class="kpi-progress-ring"
             data-progress="100">
            <span>0%</span>
        </div>
    </div>


    <div class="stat-card">
        <h3>Low Stock Items</h3>

        <div class="number kpi-counter"
             data-target="<?= (int) $data['lowStock'] ?>">
            0
        </div>

        <div class="kpi-progress-ring danger"
             data-progress="<?= $data['inventoryItems'] > 0 ? min(100, (($data['lowStock'] / $data['inventoryItems']) * 100)) : 0 ?>">
            <span>0%</span>
        </div>
    </div>


    <div class="stat-card">
        <h3>Inventory Health</h3>

        <div class="number">
            <?= $data['inventoryItems'] > 0
                ? round(100 - (($data['lowStock'] / $data['inventoryItems']) * 100))
                : 100 ?>%
        </div>

        <div class="kpi-progress-ring success"
             data-progress="<?= $data['inventoryItems'] > 0
                ? max(0, min(100, 100 - (($data['lowStock'] / $data['inventoryItems']) * 100)))
                : 100 ?>">
            <span>0%</span>
        </div>
    </div>

</div>


