<h2>Edit Purchase Item</h2>

<form method="post">

    <!-- Purchase Order -->

    <p>
        <label>Purchase Order</label><br>

        <select name="PurchaseOrderID" required>

            <option value="">-- Select Purchase Order --</option>

            <?php foreach ($purchaseOrders as $purchaseOrder): ?>

                <option
                    value="<?= $this->escapeHtml($purchaseOrder['PurchaseOrderID']) ?>"
                    <?= ($purchaseOrder['PurchaseOrderID'] == $item['PurchaseOrderID']) ? 'selected' : '' ?>
                >

                    <?= $this->escapeHtml($purchaseOrder['PurchaseOrderNumber']) ?>

                </option>

            <?php endforeach; ?>

        </select>
    </p>


    <!-- Product -->

    <p>
        <label>Product</label><br>

        <select name="ProductID" required>

            <option value="">-- Select Product --</option>

            <?php foreach ($products as $product): ?>

                <option
                    value="<?= $this->escapeHtml($product['ProductID']) ?>"
                    <?= ($product['ProductID'] == $item['ProductID']) ? 'selected' : '' ?>
                >

                    <?= $this->escapeHtml($product['ProductCode']) ?>
                    -
                    <?= $this->escapeHtml($product['ProductName']) ?>

                </option>

            <?php endforeach; ?>

        </select>
    </p>


    <!-- Quantity -->

    <p>
        <label>Quantity</label><br>

        <input
            type="number"
            name="Quantity"
            value="<?= $this->escapeHtml($item['Quantity']) ?>"
            min="1"
            required
        >
    </p>


    <!-- Unit Cost -->

    <p>
        <label>Unit Cost</label><br>

        <input
            type="number"
            name="UnitCost"
            value="<?= $this->escapeHtml($item['UnitCost']) ?>"
            step="0.01"
            min="0"
            required
        >
    </p>


    <button type="submit">
        Update Purchase Item
    </button>

</form>

<br>

<a href="<?= $this->url('purchase-item') ?>">
    Back
</a>