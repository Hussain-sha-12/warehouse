<h2>Add Inventory</h2>

<form method="post">

    <p>
        <label>Product</label><br>

        <select name="ProductID" required>
            <option value="">-- Select Product --</option>

            <?php foreach ($products as $product): ?>
                <option value="<?= $this->escapeHtml($product['ProductID']) ?>">
                    <?= $this->escapeHtml($product['ProductCode']) ?>
                    -
                    <?= $this->escapeHtml($product['ProductName']) ?>
                </option>
            <?php endforeach; ?>

        </select>
    </p>

    <p>
        <label>Quantity</label><br>

        <input
            type="number"
            name="Quantity"
            min="0"
            value="0"
            required
        >
    </p>

    <p>
        <label>Reorder Level</label><br>

        <input
            type="number"
            name="ReorderLevel"
            min="0"
            value="0"
            required
        >
    </p>

    <button type="submit">
        Save Inventory
    </button>

</form>

<br>

<a href="<?= $this->url('inventory') ?>">
    Back
</a>