<h2>Edit Purchase Order</h2>

<form method="post">

    <p>
        <label>Purchase Order Number</label><br>
        <input
            type="text"
            name="PurchaseOrderNumber"
            value="<?= $this->escapeHtml($purchase['PurchaseOrderNumber']) ?>"
            required
        >
    </p>

    <p>
        <label>Supplier ID</label><br>
        <input
            type="number"
            name="SupplierID"
            value="<?= $this->escapeHtml($purchase['SupplierID']) ?>"
            required
        >
    </p>

    <p>
        <label>Warehouse ID</label><br>
        <input
            type="number"
            name="WarehouseID"
            value="<?= $this->escapeHtml($purchase['WarehouseID']) ?>"
            required
        >
    </p>

    <p>
        <label>Order Date</label><br>
        <input
            type="datetime-local"
            name="OrderDate"
            value="<?= date('Y-m-d\TH:i', strtotime($purchase['OrderDate'])) ?>"
            required
        >
    </p>

    <p>
        <label>Status</label><br>

        <select name="Status">

            <option value="Pending"
                <?= ($purchase['Status'] == 'Pending') ? 'selected' : '' ?>>
                Pending
            </option>

            <option value="Approved"
                <?= ($purchase['Status'] == 'Approved') ? 'selected' : '' ?>>
                Approved
            </option>

            <option value="Received"
                <?= ($purchase['Status'] == 'Received') ? 'selected' : '' ?>>
                Received
            </option>

            <option value="Cancelled"
                <?= ($purchase['Status'] == 'Cancelled') ? 'selected' : '' ?>>
                Cancelled
            </option>

        </select>
    </p>

    <p>
        <label>Total Amount</label><br>
        <input
            type="number"
            name="TotalAmount"
            step="0.01"
            value="<?= $this->escapeHtml($purchase['TotalAmount']) ?>"
            required
        >
    </p>

    <p>
        <label>Created By</label><br>
        <input
            type="number"
            name="CreatedBy"
            value="<?= $this->escapeHtml($purchase['CreatedBy']) ?>"
        >
    </p>

    <button type="submit">Update Purchase Order</button>

</form>

<br>

