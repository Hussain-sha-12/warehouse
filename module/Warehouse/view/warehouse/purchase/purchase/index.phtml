<h2>Purchase Orders</h2>

<p>
    <a href="<?= $this->url('purchase/add') ?>">
        Create Purchase Order
    </a>
</p>

<hr>

<?php if (!empty($purchases)): ?>

<table border="1" cellpadding="8" cellspacing="0">

    <tr>
        <th>ID</th>
        <th>Purchase Order Number</th>
        <th>Supplier</th>
        <th>Warehouse</th>
        <th>Order Date</th>
        <th>Status</th>
        <th>Total Amount</th>
        <th>Action</th>
    </tr>

    <?php foreach ($purchases as $purchase): ?>

        <tr>

            <td>
                <?= (int) $purchase['PurchaseOrderID'] ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $purchase['PurchaseOrderNumber']
                ) ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $purchase['SupplierName']
                ) ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $purchase['WarehouseName']
                ) ?>
            </td>

            <td>
                <?= $this->escapeHtml(
                    $purchase['OrderDate']
                ) ?>
            </td>

            <td>

                <?php
                $status =
                    $purchase['Status'] ?? 'Pending';
                ?>

                <strong>
                    <?= $this->escapeHtml($status) ?>
                </strong>

            </td>

            <td>
                <?= number_format(
                    (float) (
                        $purchase['TotalAmount'] ?? 0
                    ),
                    2
                ) ?>
            </td>

            <td>

                <a href="<?= $this->url(
    'purchase/view',
    [
        'id' => $purchase['PurchaseOrderID']
    ]
) ?>">
    View
</a>

            </td>

        </tr>

    <?php endforeach; ?>

</table>

<?php else: ?>

<p>
    <strong>
        No purchase orders found.
    </strong>
</p>

<?php endif; ?>