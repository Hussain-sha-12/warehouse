<h2>Create Sales Order</h2>

<?php if (!empty($error)): ?>

    <p style="color:red; font-weight:bold;">
        <?= $this->escapeHtml($error) ?>
    </p>

<?php endif; ?>


<form method="post">

    <!-- CUSTOMER -->

    <p>
        <label>
            <strong>Customer:</strong>
        </label>
        <br>

        <select name="CustomerID" required>

            <option value="">
                -- Select Customer --
            </option>

            <?php foreach ($customers as $customer): ?>

                <option
                    value="<?= (int) $customer['CustomerID'] ?>"
                >
                    <?= $this->escapeHtml(
                        $customer['CustomerCode']
                    ) ?>

                    -
                    
                    <?= $this->escapeHtml(
                        $customer['CustomerName']
                    ) ?>

                    <?php if (!empty($customer['Phone'])): ?>

                        -
                        <?= $this->escapeHtml(
                            $customer['Phone']
                        ) ?>

                    <?php endif; ?>

                </option>

            <?php endforeach; ?>

        </select>

    </p>


    <!-- PRODUCT -->

    <p>
        <label>
            <strong>Product:</strong>
        </label>
        <br>

        <select
            name="ProductID"
            id="ProductID"
            required
        >

            <option value="">
                -- Select Product --
            </option>

            <?php foreach ($products as $product): ?>

                <option
                    value="<?= (int) $product['ProductID'] ?>"
                    data-price="<?= htmlspecialchars(
                        $product['UnitPrice'],
                        ENT_QUOTES,
                        'UTF-8'
                    ) ?>"
                    data-stock="<?= (int) $product['StockQuantity'] ?>"
                >

                    <?= $this->escapeHtml(
                        $product['ProductCode']
                    ) ?>

                    -

                    <?= $this->escapeHtml(
                        $product['ProductName']
                    ) ?>

                    -
                    Stock:
                    <?= (int) $product['StockQuantity'] ?>

                    -
                    Price:
                    ₹<?= number_format(
                        (float) $product['UnitPrice'],
                        2
                    ) ?>

                </option>

            <?php endforeach; ?>

        </select>

    </p>


    <!-- AVAILABLE STOCK -->

    <p>

        <label>
            <strong>Available Stock:</strong>
        </label>
        <br>

        <input
            type="text"
            id="AvailableStock"
            value=""
            readonly
        >

    </p>


    <!-- QUANTITY -->

    <p>

        <label>
            <strong>Quantity:</strong>
        </label>
        <br>

        <input
            type="number"
            name="Quantity"
            id="Quantity"
            min="1"
            value="1"
            required
        >

    </p>


    <!-- UNIT PRICE -->

    <p>

        <label>
            <strong>Unit Price:</strong>
        </label>
        <br>

        <input
            type="number"
            name="UnitPrice"
            id="UnitPrice"
            step="0.01"
            min="0.01"
            readonly
            required
        >

    </p>


    <!-- TOTAL -->

    <p>

        <label>
            <strong>Total Amount:</strong>
        </label>
        <br>

        <input
            type="text"
            id="TotalAmount"
            value="0.00"
            readonly
        >

    </p>


    <!-- SUBMIT -->

    <p>

        <button
            type="submit"
            id="createSaleButton"
        >
            Create Sale
        </button>

        &nbsp;

        <a href="<?= $this->url('sales') ?>">
            Cancel
        </a>

    </p>

</form>


<script>

(function () {

    var productSelect =
        document.getElementById('ProductID');

    var quantityInput =
        document.getElementById('Quantity');

    var unitPriceInput =
        document.getElementById('UnitPrice');

    var stockInput =
        document.getElementById('AvailableStock');

    var totalInput = 
        document.getElementById('TotalAmount');


    function updateProductDetails()
    {
        var selected =
            productSelect.options[
                productSelect.selectedIndex
            ];


        if (!selected || !selected.value) {

            unitPriceInput.value = '';

            stockInput.value = '';

            totalInput.value = '0.00';

            return;
        }


        var price =
            parseFloat(
                selected.getAttribute('data-price')
            ) || 0;


        var stock =
            parseInt(
                selected.getAttribute('data-stock'),
                10
            ) || 0;


        unitPriceInput.value =
            price.toFixed(2);

        stockInput.value =
            stock;


        calculateTotal();
    }


    function calculateTotal()
    {
        var quantity =
            parseFloat(
                quantityInput.value
            ) || 0;


        var price =
            parseFloat(
                unitPriceInput.value
            ) || 0;


        var total =
            quantity * price;


        totalInput.value =
            total.toFixed(2);
    }


    productSelect.addEventListener(
        'change',
        updateProductDetails
    );


    quantityInput.addEventListener(
        'input',
        calculateTotal
    );


    /*
     * Initial calculation
     */
    updateProductDetails();

})();

</script>